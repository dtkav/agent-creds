#!/bin/sh
# Opens URL on host via browser-forward unix socket

url="$1"
if [ -z "$url" ]; then
    echo "Usage: open-browser <url>" >&2
    exit 1
fi

# tcp-bridge creates this socket. bwrap publishes its protected bridge from a
# read-only per-instance directory; container runtimes use the legacy path.
sock="${BROWSER_SOCKET_PATH:-/tmp/browser-forward.sock}"
if [ ! -S "$sock" ]; then
    echo "No browser-forward socket found" >&2
    exit 1
fi

# Keep this synchronous so a denied target, dead host opener, or unavailable
# OAuth callback is reported to the agent instead of looking like success.
exec curl --fail --silent --show-error --max-time 15 \
    -G --data-urlencode "url=$url" \
    --unix-socket "$sock" "http://localhost/open"
